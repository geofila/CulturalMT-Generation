<skos:prefLabel xml:lang='el'>Δαρειώτης Μίμης</skos:prefLabel>
<rdaGr2:dateOfBirth>1943</rdaGr2:dateOfBirth>
<rdaGr2:dateOfDeath>2022</rdaGr2:dateOfDeath>
<rdaGr2:placeOfBirth><rdf:Description rdf:about='http://semantics.gr/authorities/geonames-places-earth/257149'><rdfs:label xml:lang='el'>Ευρώπη ▶ Ελλάδα ▶ Περιφέρεια Πελοποννήσου ▶ Νομός Μεσσηνίας</rdfs:label>
