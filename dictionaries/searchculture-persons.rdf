<edm:Agent rdf:about='http://semantics.gr/authorities/searchculture-persons/1554043904'><skos:prefLabel xml:lang='en'>Diovouniotis Konstantinos</skos:prefLabel>
<skos:prefLabel xml:lang='el'>Δυοβουνιώτης  Κωνσταντίνος</skos:prefLabel>
<rdaGr2:dateOfDeath>1897</rdaGr2:dateOfDeath>
<rdaGr2:gender rdf:datatype='http://www.w3.org/2001/XMLSchema#string'>male</rdaGr2:gender>
<rdaGr2:professionOrOccupation><rdf:Description rdf:about='http://semantics.gr/authorities/professions-occupations/1482712895'><rdfs:label xml:lang='el'>Στρατιωτικά επαγγέλματα ▶ Στρατιωτικοί</rdfs:label>
<rdfs:label xml:lang='en'>Military professions ▶ Military officers</rdfs:label>
