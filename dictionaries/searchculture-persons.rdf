<rdaGr2:dateOfBirth>1910</rdaGr2:dateOfBirth>
<rdaGr2:dateOfDeath>1988</rdaGr2:dateOfDeath>
<rdaGr2:gender rdf:datatype='http://www.w3.org/2001/XMLSchema#string'>male</rdaGr2:gender>
